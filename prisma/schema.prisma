generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model event_logs {
  id         String   @id
  user_id    String
  event_type String
  metadata   String   @default("{}")
  created_at DateTime @default(now())
  users      users    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model favorites {
  id            String      @id
  user_id       String
  restaurant_id String
  created_at    DateTime    @default(now())
  restaurants   restaurants @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  users         users       @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([user_id, restaurant_id])
}

model meal_records {
  id              String       @id
  user_id         String
  restaurant_id   String?
  restaurant_name String
  category        String
  photo_url       String?
  eaten_at        DateTime     @default(now())
  created_at      DateTime     @default(now())
  restaurants     restaurants? @relation(fields: [restaurant_id], references: [id])
  users           users        @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model restaurants {
  id             String         @id
  kakao_place_id String         @unique
  name           String
  category       String
  lat            Float
  lng            Float
  rating         Float?
  cached_at      DateTime       @default(now())
  favorites      favorites[]
  meal_records   meal_records[]
  swipe_logs     swipe_logs[]
}

model swipe_logs {
  id            String      @id
  user_id       String
  restaurant_id String
  direction     String
  category      String
  swiped_at     DateTime    @default(now())
  restaurants   restaurants @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  users         users       @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model users {
  id            String         @id
  kakao_id      String?        @unique
  location_lat  Float?
  location_lng  Float?
  distance_pref Int            @default(10)
  allergies     String         @default("[]")
  created_at    DateTime       @default(now())
  email         String?
  image         String?
  name          String?
  event_logs    event_logs[]
  favorites     favorites[]
  meal_records  meal_records[]
  swipe_logs    swipe_logs[]
}
